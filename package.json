    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.12",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
