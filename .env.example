# Set the real published domain before production deployment for absolute OG URLs.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase project settings > API. Only these two values are public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server ONLY. Never prefix any of these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Authentication > Users > UUID (comma-separated allowlist).
SUPABASE_ADMIN_USER_IDS=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GUESTBOOK_HASH_SECRET=
# Production canonical origin, e.g. https://your-domain.example (no trailing slash).
# APP_ORIGIN=http://localhost:3000
# Only set to a SINGLE-IP header overwritten by your trusted reverse proxy.
# Vercel: x-real-ip. Cloudflare: cf-connecting-ip, with origin access locked down.
# If unset, safe shared network rate limit (3 messages/minute for the entire site).
GUESTBOOK_TRUSTED_IP_HEADER=
